# Salin ke .env lalu isi nilai ASLI di server/lokal. JANGAN commit .env.
APP_NAME="Donasi Relawan Komunitas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

# Database Neon (PostgreSQL) — satu URL saja, dari dashboard Neon.
# Contoh bentuk (JANGAN isi nilai asli di repo):
# DATABASE_URL="postgres://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=
DB_CONNECTION=sqlite
# Fallback lokal bila DATABASE_URL kosong (pengembangan): sqlite
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/ke/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_COOKIE=donasi_relawan_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
